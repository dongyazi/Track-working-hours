<view class="container">
  <!-- 顶部状态栏占位 -->
  <view class="header">
    <text class="brand">工时随手记</text>
    <view class="settings-icon"></view>
  </view>

  <!-- 今日工时大卡片 -->
  <view class="work-card">
    <view class="clock-display">{{currentTime}}</view>
    <view class="work-info">
      <text class="label">今日已工作</text>
      <text class="duration">{{todayWorkTime}}</text>
    </view>
    <view class="income-info">
      <text class="label">预估收入</text>
      <text class="income">¥ {{todayIncome}}</text>
    </view>
  </view>

  <!-- 打卡操作区 -->
  <view class="action-section">
    <view class="project-info" wx:if="{{lastProject}}">
      上次项目：<text class="project-name" style="color: {{lastProject.color}}">{{lastProject.name}}</text>
    </view>
    <view class="project-info" wx:else>
      请先创建并选择一个项目
    </view>

    <button class="clock-btn" bindtap="onClockOut" disabled="{{!lastProject}}">
      <text class="btn-icon">📍</text>
      <text>下班打卡</text>
    </button>

    <view class="sub-actions">
      <view class="sub-btn" bindtap="onChangeProject">
        <text class="sub-btn-icon">🔄</text>
        <text>换项目</text>
      </view>
      <view class="sub-btn" bindtap="onAddRecord">
        <text class="sub-btn-icon">📝</text>
        <text>补记录</text>
      </view>
    </view>
  </view>

  <!-- 今日摘要 -->
  <view class="today-summary">
    <text>⚡今日记录：{{todayRecordsCount}}条</text>
  </view>

  <!-- 项目选择器弹窗 -->
  <view class="modal-overlay" wx:if="{{showProjectSelector}}" bindtap="hideProjectSelector">
    <view class="project-selector" catchtap="true">
      <view class="selector-header">
        <text>选择项目</text>
        <view class="close-btn" bindtap="hideProjectSelector">✕</view>
      </view>
      <scroll-view scroll-y class="project-list">
        <view 
          class="project-item" 
          wx:for="{{projects}}" 
          wx:key="id" 
          bindtap="onSelectProject" 
          data-project="{{item}}"
        >
          <view class="project-dot" style="background-color: {{item.color}}"></view>
          <text class="project-name-text">{{item.name}}</text>
          <text class="project-rate">¥{{item.hourlyRate}}/h</text>
        </view>
      </scroll-view>
      <view class="selector-footer" bindtap="onChangeProject">
        <text>管理项目 ›</text>
      </view>
    </view>
  </view>

  <!-- 打卡成功提示 -->
  <view class="success-overlay" wx:if="{{showSuccessOverlay}}">
    <view class="success-content">
      <view class="success-icon-wrap">
        <text class="success-icon-check">✓</text>
      </view>
      <text class="success-title">打卡成功！</text>
      <view class="success-detail" wx:if="{{lastRecord}}">
        <text class="success-project">{{lastRecord.projectName}}</text>
        <text class="success-time">{{lastRecord.startTime}} - {{lastRecord.endTime}}</text>
      </view>
    </view>
  </view>
</view>
