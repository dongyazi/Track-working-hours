<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatar}}"></image>
    <view class="user-info">
      <text class="name">{{userInfo.name}}</text>
      <view class="stats-row">
        <text class="stat-label">累计工时:</text>
        <text class="stat-value">{{userInfo.totalDuration}}h</text>
      </view>
    </view>
    <view class="rate-badge" bindtap="onHourlyRateChange">
      <text>¥{{userInfo.hourlyRate}}/h</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-section">
    <view class="section-title">项目管理</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="navToProjects">
        <view class="menu-left">
          <text class="menu-icon">📋</text>
          <text>我的项目</text>
        </view>
        <view class="menu-right">
          <text class="count-badge">{{projectCount}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title">数据工具</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="onExport">
        <view class="menu-left">
          <text class="menu-icon">📤</text>
          <text>导出数据</text>
          <text class="vip-tag">VIP</text>
        </view>
        <view class="menu-right">
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="menu-item" bindtap="onBackup">
        <view class="menu-left">
          <text class="menu-icon">☁️</text>
          <text>云端备份</text>
          <text class="vip-tag">VIP</text>
        </view>
        <view class="menu-right">
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title">通用设置</view>
    <view class="menu-list">
      <view class="menu-item">
        <view class="menu-left">
          <text class="menu-icon">⏰</text>
          <text>打卡提醒时间</text>
        </view>
        <view class="menu-right">
          <picker mode="time" value="{{reminderTime}}" bindchange="onReminderTimeChange">
            <view class="picker-val">{{reminderTime}}</view>
          </picker>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="menu-item" bindtap="onHourlyRateChange">
        <view class="menu-left">
          <text class="menu-icon">💰</text>
          <text>默认时薪</text>
        </view>
        <view class="menu-right">
          <text class="val">¥{{userInfo.hourlyRate}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="version-info">版本 v1.0.0</view>
</view>
